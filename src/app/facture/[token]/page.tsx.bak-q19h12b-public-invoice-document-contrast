                <p className="text-xs font-black uppercase tracking-[0.26em] text-[#f8d479]">
                  Actions rapides
                </p>

                <div className="mt-5 grid gap-3">
                  <QuickAction
                    href={buildAmarkhysWhatsAppHref(whatsappText)}
                    external
                    gold
                  >
                    <MessageCircle className="h-5 w-5" />
                    WhatsApp
                  </QuickAction>

                  <QuickAction href={buildAmarkhysTelHref()}>
                    <Phone className="h-5 w-5 text-[#23ead4]" />
                    Appeler le garage
                  </QuickAction>

                  <QuickAction href="/">
                    <ArrowLeft className="h-5 w-5 text-[#23ead4]" />
                    Retour au site
                  </QuickAction>
                </div>
              </div>

              <div className="rounded-[1.35rem] border border-[#23ead4]/22 bg-gradient-to-br from-[#075f53] via-[#06443d] to-[#041b18] p-6 shadow-[0_30px_90px_rgba(0,0,0,0.42)]">
                <div className="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-full border border-[#23ead4]/35 bg-[#063f39] text-[#23ead4]">
                  <ShieldCheck className="h-6 w-6" />
                </div>

                <p className="text-sm font-black uppercase tracking-[0.16em] text-[#23ead4]">
                  Paiement en ligne
                </p>

                <p className="mt-3 text-sm leading-6 text-cyan-50/75">
                  Module de règlement sécurisé à connecter dans une prochaine étape.
                </p>
              </div>
            </div>
          </aside>
        </div>
      </section>
    </main>
  );
}
