                        <BadgeCheck className="h-4 w-4" />
                      )}
                      {summary.isCancelledInvoice ? "Historique" : "Document officiel"}
                    </div>
                  </div>
                </div>
              </div>

              {summary.isCancelledInvoice ? (
                <div className="border-b border-red-400/20 bg-red-500/10 p-6 sm:p-8">
                  <p className="text-xs font-black uppercase tracking-[0.25em] text-red-200">
                    Facture annulée
                  </p>

                  <h4 className="mt-3 text-2xl font-black text-white">
