              <span className="pb-1 text-xl font-black text-slate-300">
                Garage
              </span>
            </div>

            <h2 className="mt-6 text-3xl font-black text-white sm:text-4xl">
              {summary.isCancelledInvoice
                ? "Facture annulée"
                : "Votre facture AMARKHYS"}
            </h2>

            <p className="mt-2 max-w-2xl text-base leading-7 text-slate-300">
              {summary.isCancelledInvoice
                ? "Cette facture reste consultable pour historique. Aucun nouveau règlement ne doit être initié depuis ce lien."
