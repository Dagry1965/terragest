      )}
      className="space-y-5 sm:space-y-6 lg:space-y-8 rounded-2xl border border-[var(--erp-border)] bg-[var(--erp-bg)] p-3 sm:p-4 lg:p-6 shadow-[0_14px_40px_rgba(15,23,42,0.07)] md:p-6"
      data-erp-form-theme={
        module.metadata.category === "amarkhys" ||
        module.metadata.key.endsWith("auto")
          ? "amarkhys-petronas"
          : module.metadata.category === "production" ||
              module.metadata.category === "agri"
            ? "agri-enterprise"
            : "default-enterprise"
      }
      onSubmit={handleSubmit}
    >
      {/* Tout ton JSX reste identique */}
      {/* ... */}
    </form>
  );
